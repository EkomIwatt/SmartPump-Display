# Copy to `keystore.properties` (repo root) and fill in. That file is gitignored and must stay
# that way — it holds the keys to every future update of the app.
#
# CI can supply the same four values as environment variables instead:
#   SMARTPUMP_STORE_FILE  SMARTPUMP_STORE_PASSWORD  SMARTPUMP_KEY_ALIAS  SMARTPUMP_KEY_PASSWORD
#
# See docs/RELEASE.md for how to create the keystore and what to do with it afterwards.

# Path to the keystore. Relative paths resolve against the repo root; an absolute path pointing
# somewhere OUTSIDE the repo is safer, because it cannot be committed by accident.
storeFile=../smartpump-release.jks

storePassword=
keyAlias=smartpump
keyPassword=
