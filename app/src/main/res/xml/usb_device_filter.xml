<?xml version="1.0" encoding="utf-8"?>
<!-- USB serial adapters used for the pulse-tap bench rig. vendor-id values are DECIMAL.
     Listing vendor-id only matches any product from that vendor (permissive — bench rigs vary). -->
<resources>
    <!-- Arduino (Uno R3 / Mega native USB)  0x2341 -->
    <usb-device vendor-id="9025" />
    <!-- QinHeng CH340 / CH341  0x1A86  (common on Uno clones / Nano) -->
    <usb-device vendor-id="6790" />
    <!-- FTDI FT232  0x0403 -->
    <usb-device vendor-id="1027" />
    <!-- Silicon Labs CP210x  0x10C4 -->
    <usb-device vendor-id="4292" />
</resources>
