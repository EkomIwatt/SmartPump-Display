<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build manifest overlay. Merges android:networkSecurityConfig onto the app's <application>
  so debuggable builds allow cleartext to the local dev backend (see res/xml/network_security_config).
  Kept out of the main manifest so release stays cleartext-denied by default.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
